{
  "name": "topiq-explorer",
  "version": "1.3.6",
  "description": "A cross-platform desktop application for exploring and managing Apache Kafka clusters",
  "main": "dist-electron/main.js",
  "author": "Nihil Babu <babunihil@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/exitCodeNihil/topiq-explorer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.electron.json --noEmit && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac --x64",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.321.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtuoso": "^4.6.2",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "resolutions": {
    "tar": ">=7.5.21",
    "minimatch": ">=10.2.5",
    "rollup": ">=4.60.2",
    "esbuild": "0.28.2",
    "ajv": ">=8.18.0",
    "protobufjs": "^8.6.6",
    "@babel/core": "^7.29.6",
    "@xmldom/xmldom": "^0.9.12",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.6",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss-selector-parser": "^6.1.3",
    "shell-quote": "^1.9.0",
    "tmp": "^0.2.6",
    "undici": "^6.28.0",
    "postcss": "^8.5.23",
    "plist": "^3.1.1"
  },
  "build": {
    "appId": "com.topiq-explorer.app",
    "productName": "Topiq Explorer",
    "publish": {
      "provider": "github",
      "owner": "exitCodeNihil",
      "repo": "topiq-explorer"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "artifactName": "${name}-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "${name}-${version}.${ext}",
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}.${ext}"
    },
    "linux": {
      "artifactName": "${name}-${version}.${ext}",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
